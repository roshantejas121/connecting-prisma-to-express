# Copy this file to ".env" (which is git-ignored) and fill in your real values:
#   cp .env.example .env
#
# DATABASE_URL points Prisma at your local PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Create the "threadbase" database first (e.g. `createdb threadbase`).

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/threadbase?schema=public"
